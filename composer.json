{
  "name": "erseco/autofirma-intermediate-server",
  "description": "Framework-agnostic PHP implementation of the AutoFirma intermediate server protocol",
  "keywords": [
    "autofirma",
    "electronic-signature",
    "intermediate-server",
    "php"
  ],
  "homepage": "https://github.com/erseco/autofirma-intermediate-server",
  "license": "GPL-2.0-or-later",
  "type": "library",
  "authors": [
    {
      "name": "Ernesto Serrano",
      "homepage": "https://github.com/erseco"
    }
  ],
  "support": {
    "issues": "https://github.com/erseco/autofirma-intermediate-server/issues",
    "source": "https://github.com/erseco/autofirma-intermediate-server"
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12 || ^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "Erseco\\AutoFirma\\IntermediateServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Erseco\\AutoFirma\\IntermediateServer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "fix": "phpcbf --standard=.phpcs.xml.dist",
    "lint": "phpcs --standard=.phpcs.xml.dist",
    "test": "phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.agents",
      "/.claude",
      "/.github",
      "/docs",
      "/tests",
      "/AGENTS.md",
      "/CONTRIBUTING.md",
      "/Makefile",
      "/phpstan.neon.dist",
      "/phpunit.xml.dist"
    ]
  }
}
